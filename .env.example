APP_NAME=Backend Tesis Apnea
APP_ENV=development

# Ruta del modelo entrenado
MODEL_PATH=./modelo_resnet_apnea_central_0-7.pth
MODEL_THRESHOLD=0.5

# PostgreSQL/Supabase. Para Render usa el Session Pooler IPv4 de Supabase,
# disponible en Dashboard > Connect > Session pooler (no db.<ref>.supabase.co).
# El usuario del Shared Pooler incluye el project ref: postgres.<PROJECT_REF>.
DB_HOST=aws-0.TU_REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_SSLMODE=require

# JWT y autenticación
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
AUTH_USERNAME=admin
AUTH_PASSWORD=CAMBIA_ESTA_CLAVE
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# CORS: separa origenes con coma. Usa * solo en desarrollo.
CORS_ORIGINS=*
