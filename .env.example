APP_NAME=Backend Tesis Apnea
APP_ENV=development

# Ruta del modelo entrenado
MODEL_PATH=./modelo_resnet_apnea_central_0-7.pth
MODEL_THRESHOLD=0.5

# PostgreSQL/Supabase. En Render, DB_PASSWORD debe ser secreto.
DB_HOST=db.TU_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_SSLMODE=require

# JWT y autenticación
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
AUTH_USERNAME=admin
AUTH_PASSWORD=CAMBIA_ESTA_CLAVE
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# CORS: separa origenes con coma. Usa * solo en desarrollo.
CORS_ORIGINS=*
